[Unit]
Description=UtterMux Zotero Read Aloud bridge
After=uttermux.socket
Requires=uttermux.socket

[Service]
ExecStart=@CMAKE_INSTALL_FULL_LIBDIR@/uttermux/zotero-bridge --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
