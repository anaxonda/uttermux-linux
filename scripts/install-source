#!/usr/bin/env bash
set -euo pipefail

repo=https://github.com/anaxonda/uttermux-linux
sherpa_version=1.13.6
prefix=${UTTERMUX_PREFIX:-/usr/local}
build_jobs=${UTTERMUX_BUILD_JOBS:-2}
[[ $build_jobs =~ ^[1-9][0-9]*$ ]] || { printf '%s\n' 'UTTERMUX_BUILD_JOBS must be a positive integer.' >&2; exit 2; }

if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
  printf '%s\n' 'Run this installer as your normal user; it invokes sudo only for installation.' >&2
  exit 2
fi
for command in curl cmake ninja g++ pkg-config python3 sudo tar; do
  command -v "$command" >/dev/null || { printf 'Missing required command: %s\n' "$command" >&2; exit 2; }
done
pkg-config --exists rubberband || { printf '%s\n' 'Missing Rubber Band development files.' >&2; exit 2; }

work=$(mktemp -d "${TMPDIR:-/tmp}/uttermux-source.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT

printf '%s\n' 'Resolving the latest published UtterMux release…'
curl --proto '=https' --tlsv1.2 -fsSL \
  https://api.github.com/repos/anaxonda/uttermux-linux/releases?per_page=10 -o "$work/releases.json"
tag=$(sed -n 's/.*"tag_name": "\([^"]*\)".*/\1/p' "$work/releases.json" | head -n1)
[[ "$tag" =~ ^v[0-9A-Za-z._-]+$ ]] || { printf '%s\n' 'Could not resolve a safe release tag.' >&2; exit 1; }
version=${tag#v}
checksums_url="$repo/releases/download/$tag/SHA256SUMS"
archive_url="$repo/releases/download/$tag/uttermux-linux-$version.tar.gz"
curl --proto '=https' --tlsv1.2 -fsSL "$checksums_url" -o "$work/SHA256SUMS"
archive=${archive_url##*/}
[[ -n "$archive" ]] || { printf '%s\n' 'Release checksum manifest has no source archive.' >&2; exit 1; }
curl --proto '=https' --tlsv1.2 -fL "$archive_url" -o "$work/$archive"
expected=$(awk -v file="$archive" '$2 == file {print $1}' "$work/SHA256SUMS")
[[ "$expected" =~ ^[0-9a-f]{64}$ ]] || { printf '%s\n' "No checksum was published for $archive." >&2; exit 1; }
(cd "$work" && printf '%s  %s\n' "$expected" "$archive" | sha256sum --check)
tar -xzf "$work/$archive" -C "$work"
source_root=$(find "$work" -mindepth 1 -maxdepth 1 -type d -name 'uttermux-linux-*' -print -quit)
[[ -n "$source_root" ]] || { printf '%s\n' 'Could not locate extracted UtterMux source.' >&2; exit 1; }
if [[ ${UTTERMUX_INSTALL_CHECK_ONLY:-0} == 1 ]]; then
  printf 'Verified release source: %s\n' "$archive"
  exit 0
fi

printf '%s\n' "Building sherpa-onnx $sherpa_version…"
curl --proto '=https' --tlsv1.2 -fL \
  "https://github.com/k2-fsa/sherpa-onnx/archive/refs/tags/v$sherpa_version.tar.gz" \
  -o "$work/sherpa.tar.gz"
tar -xzf "$work/sherpa.tar.gz" -C "$work"
# GCC 16 rejects sherpa-onnx 1.13.6's bundled eSpeak -Wno-format override when
# a distribution enables -Werror=format-security. Preserve the distribution's
# format hardening by removing only that upstream override.
sed -i '/^[[:space:]]*-Wno-format$/d' \
  "$work/sherpa-onnx-$sherpa_version/cmake/espeak-ng-for-piper.cmake"
! grep -Eq '^[[:space:]]*-Wno-format$' \
  "$work/sherpa-onnx-$sherpa_version/cmake/espeak-ng-for-piper.cmake"
cmake -S "$work/sherpa-onnx-$sherpa_version" -B "$work/sherpa-build" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$prefix" -DBUILD_SHARED_LIBS=ON \
  -DSHERPA_ONNX_ENABLE_TTS=ON -DSHERPA_ONNX_ENABLE_C_API=ON \
  -DSHERPA_ONNX_ENABLE_BINARY=OFF -DSHERPA_ONNX_ENABLE_PYTHON=OFF \
  -DSHERPA_ONNX_ENABLE_TESTS=OFF -DSHERPA_ONNX_ENABLE_CHECK=OFF \
  -DSHERPA_ONNX_ENABLE_PORTAUDIO=OFF -DSHERPA_ONNX_ENABLE_WEBSOCKET=OFF \
  -DSHERPA_ONNX_ENABLE_SPEAKER_DIARIZATION=OFF \
  -DSHERPA_ONNX_USE_PRE_INSTALLED_ONNXRUNTIME_IF_AVAILABLE=OFF
cmake --build "$work/sherpa-build" --parallel "$build_jobs"

cmake -S "$source_root" -B "$work/build" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$prefix"
cmake --build "$work/build" --parallel "$build_jobs"
ctest --test-dir "$work/build" --output-on-failure
sudo cmake --install "$work/sherpa-build"
sudo cmake --install "$work/build"
sudo ldconfig

# Keep the two pure-Python runtime dependencies private to UtterMux.
vendor="$prefix/lib/uttermux/vendor"
sudo mkdir -p "$vendor"
python3 -m pip install --disable-pip-version-check --no-deps --target "$work/vendor" \
  edge-tts==7.2.8 py3langid==0.3.0
sudo cp -a "$work/vendor/." "$vendor/"

uttermux setup
uttermux doctor
printf '%s\n' 'UtterMux is installed. Restart applications that cache system voice lists.'
