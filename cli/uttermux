def GLib_find_program(name: str) -> str | None:
    """Avoid importing GTK's GLib into the command-line client."""
    return shutil.which(name)


def cmd_preview_url(args):
    parsed = urllib.parse.urlparse(args.url)
    if parsed.scheme != "https" or not parsed.hostname:
        raise RuntimeError("preview URL must be HTTPS")
    request = urllib.request.Request(args.url, headers={"User-Agent": "UtterMux/1"})
    with urllib.request.urlopen(request, timeout=30) as response:
        # Decode explicitly to mono PCM; this also supports MP3 and WAV catalog samples.
        decoder = subprocess.Popen([
            "ffmpeg", "-nostdin", "-loglevel", "error", "-i", "pipe:0", "-f", "s16le",
            "-acodec", "pcm_s16le", "-ar", "24000", "-ac", "1", "pipe:1"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        playback = subprocess.Popen(["paplay", "--raw", "--format=s16le", "--rate=24000", "--channels=1"],
                                    stdin=decoder.stdout)
        decoder.stdout.close()
        try:
            shutil.copyfileobj(response, decoder.stdin)
            decoder.stdin.close()
            if decoder.wait() or playback.wait():
                raise RuntimeError("could not play catalog preview")
        finally:
            if decoder.poll() is None: decoder.terminate()
            if playback.poll() is None: playback.terminate()


def detect_text(text: str) -> tuple[str, float, str]:
    routing = read_config().get("routing", {})
    if sum(character.isalpha() for character in text) < int(routing.get("minimum_characters", 40)):
        return "", 0, "insufficient-text"
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    for path in (installed_helper("vendor"), data_home / "uttermux/vendor",
                 Path(__file__).resolve().parents[1] / "daemon/vendor"):
        if path.is_dir(): sys.path.insert(0, str(path))
    try:
        from py3langid.langid import LanguageIdentifier, MODEL_FILE
    except ImportError as error:
        raise RuntimeError("py3langid is not installed") from error
    detector = LanguageIdentifier.from_pickled_model(MODEL_FILE, norm_probs=True)
    language, confidence = detector.classify(text)
    minimum = float(routing.get("minimum_confidence", .8))
    return (language if float(confidence) >= minimum else "", float(confidence),
            "detected" if float(confidence) >= minimum else "low-confidence")


