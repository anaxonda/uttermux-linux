def cmd_catalog(_args):
    ready = {item["id"]: item for item in voice_records()}
    installed_model_ids = {path.stem for directory in (
        config_dir() / "models.d", config_dir().parent / "speech-dispatcher-sherpa/models.d")
        if directory.is_dir() for path in directory.glob("*.toml")}
    models, catalog_voices = [], []
    for item in local_catalog():
        languages = item.get("languages") or sorted({voice.get("language", "und") for voice in item.get("voices", [])})
        companion = item["engine"] if item.get("external_installer") else ""
        installed = (any(record["provider"] == companion for record in ready.values()) if companion else
                     item["id"] in installed_model_ids)
        models.append({
            "id": item["id"], "providerId": companion or "local",
            "library": item.get("family", item["engine"]),
            "version": item.get("version", "1"), "engine": item["engine"], "location": "on-device",
            "languages": languages, "capabilities": item.get("capabilities", []),
            "status": "ready" if installed else "downloadable",
            "downloadSizeMb": round(int(item.get("size", 0)) / 1024 / 1024),
            "estimatedRamMb": int(item.get("estimated_ram_mb", 0)),
            "quantization": item.get("quantization", ""),
            "performanceClass": item.get("performance_class", "unknown"),
            "license": item.get("license", ""), "sourceUrl": item.get("source_url", item.get("url", "")),
        })
        for voice in item.get("voices", []):
            voice_id = f"{companion}/{voice['id']}" if companion else f"sherpa/{item['id']}/{voice['id']}"
            catalog_voices.append({"id": voice_id, "modelId": item["id"],
                "speakerId": str(voice.get("speaker_id", 0)), "name": voice["name"],
                "languages": voice.get("languages", [voice.get("language", "und")]),
                "gender": voice.get("gender", ""), "preview": "generated" if voice_id in ready else
                ("sample" if voice.get("preview_url") else "unavailable"),
                "previewUrl": voice.get("preview_url", ""), "ready": voice_id in ready})
    provider_names = {"local": ("Local models", False, "free"), "qwen": ("Qwen local", False, "free"),
                      "moss": ("MOSS local", False, "free"),
                      "edge": ("Microsoft Edge", True, "free"),
                      "elevenlabs": ("ElevenLabs", True, "subscription"), "grok": ("xAI", True, "metered")}
    providers = [{"id": key, "name": values[0], "network": values[1], "cost": values[2],
                  "enabled": key in {"local", "qwen", "moss"} or bool(read_config().get("providers", {}).get(key, {}).get("enabled"))}
                 for key, values in provider_names.items()]
    local_ids = {voice["id"] for voice in catalog_voices}
    for record in ready.values():
        if record["id"] in local_ids: continue
        if record["provider"] in {"qwen", "moss"} and any(model["engine"] == record["provider"] for model in models):
            model_id = next(model["id"] for model in models if model["engine"] == record["provider"])
            catalog_voices.append({"id": record["id"], "modelId": model_id,
                "speakerId": record["id"].split("/")[-1], "name": record["name"],
                "languages": record["languages"], "preview": "generated", "ready": True})
            continue
        if record["provider"] == "local" and any(model["id"] == record["model"] for model in models):
            catalog_voices.append({"id": record["id"], "modelId": record["model"],
                "speakerId": record["id"].split("/")[-1], "name": record["name"],
                "languages": record["languages"], "preview": "generated", "ready": True,
                "profile": record["id"] in {item.get("voiceId") for item in profile_records()}})
            continue
        model_id = f"{record['provider']}/{record['model']}"
        if not any(model["id"] == model_id for model in models):
            local_companion = record["provider"] in {"qwen", "moss"}
            models.append({"id": model_id, "providerId": record["provider"], "library": record["model"],
                "version": "companion" if local_companion else "service", "engine": record["provider"],
                "location": "on-device" if local_companion else "cloud",
                "languages": record["languages"], "capabilities": ["streaming"], "status": "ready",
                "performanceClass": "heavy" if local_companion else "cloud"})
        catalog_voices.append({"id": record["id"], "modelId": model_id, "speakerId": record["id"].split("/")[-1],
            "name": record["name"], "languages": record["languages"], "preview": "generated", "ready": True})
    hardware = hardware_profile()
    for model in models:
        recommendation, reason = recommend_model(model, hardware)
        model["recommendation"] = recommendation
        model["recommendationReason"] = reason
    print(json.dumps({"schemaVersion": 1, "hardware": hardware,
                      "providers": providers, "models": models,
                      "voices": catalog_voices, "profiles": profile_records()}, ensure_ascii=False, indent=2))


def cmd_status(_args):
    document = read_config(); default_id = document.get("default_voice", "")
    available = {record["id"]: record for record in voice_records()}
    runtime = {}
    try:
        for kind, payload in transact(STATUS):
            if kind == STATE: runtime = json.loads(payload)
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError): pass
    print(json.dumps({"schemaVersion": 1, "configuredDefault": default_id,
        "routedVoice": runtime.get("routedVoice") or (default_id if default_id in available else document.get("fallback_voice", "")),
        "activeVoice": runtime.get("activeVoice", ""), "status": runtime.get("status", "idle"),
        "language": runtime.get("language") or document.get("routing", {}).get("default_language", "en-US"),
        "fallbackReason": runtime.get("fallbackReason", ""),
        "socket": str(socket_path()), "brokerAvailable": socket_path().exists(),
        "profileCount": len(profile_records())}, ensure_ascii=False, indent=2))


