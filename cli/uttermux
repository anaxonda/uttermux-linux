def cmd_preview(args):
    record = next((record for record in voice_records() if record["id"] == args.voice or record["name"] == args.voice), None)
    if not record: raise RuntimeError(f"unknown voice: {args.voice}")
    # A manager preview already has the canonical voice ID. Sending its display
    # name back through Speech Dispatcher made the module resolve it a second
    # time and was especially unreliable for reference-conditioned Pocket
    # voices. Stream this exact broker request straight to the desktop sink.
    language = args.language or record.get("native_language", "")
    payload = b"\0".join(value.encode("utf-8") for value in
                         (record["id"], "1.0", args.text, language)) + b"\0"
    playback = None
    try:
        for kind, raw in transact(SPEAK, payload):
            if kind == AUDIO_START:
                if len(raw) < 5: raise RuntimeError("invalid audio header from broker")
                sample_rate, sample_format = struct.unpack_from("<IB", raw)
                formats = {1: ("float32le", "f32"), 2: ("s16le", "s16")}
                if sample_format not in formats:
                    raise RuntimeError(f"unsupported broker audio format: {sample_format}")
                pulse_format, pipewire_format = formats[sample_format]
                player = (["paplay", "--raw", f"--format={pulse_format}", f"--rate={sample_rate}",
                           "--channels=1"] if GLib_find_program("paplay") else
                          ["pw-play", "--format", pipewire_format, "--rate", str(sample_rate),
                           "--channels", "1", "-"])
                playback = subprocess.Popen(player, stdin=subprocess.PIPE)
            elif kind == AUDIO:
                if not playback or not playback.stdin:
                    raise RuntimeError("broker sent samples before an audio header")
                playback.stdin.write(raw)
        if not playback or not playback.stdin:
            raise RuntimeError("broker returned no audio")
        playback.stdin.close()
        if playback.wait(): raise RuntimeError("audio playback failed")
    finally:
        if playback and playback.poll() is None:
            playback.terminate()


def benchmark_once(voice_id: str, text: str, language: str = "") -> dict:
    """Measure broker synthesis without including audio-device playback."""
    payload = b"\0".join(value.encode("utf-8") for value in
                         (voice_id, "1.0", text, language)) + b"\0"
    started_at = time.perf_counter()
    first_audio_at = None
    sample_rate = 0
    bytes_per_sample = 0
    audio_bytes = 0
    for kind, raw in transact(SPEAK, payload):
        now = time.perf_counter()
        if kind == AUDIO_START:
            if len(raw) < 5: raise RuntimeError("invalid audio header from broker")
            sample_rate, sample_format = struct.unpack_from("<IB", raw)
            bytes_per_sample = {1: 4, 2: 2}.get(sample_format, 0)
            if not bytes_per_sample:
                raise RuntimeError(f"unsupported broker audio format: {sample_format}")
        elif kind == AUDIO:
            if not sample_rate: raise RuntimeError("broker sent samples before an audio header")
            if first_audio_at is None: first_audio_at = now
            audio_bytes += len(raw)
    finished_at = time.perf_counter()
    if first_audio_at is None or not audio_bytes:
        raise RuntimeError("broker returned no audio")
    audio_seconds = audio_bytes / (sample_rate * bytes_per_sample)
    wall_seconds = finished_at - started_at
    return {
        "firstAudioMs": round((first_audio_at - started_at) * 1000, 1),
        "wallMs": round(wall_seconds * 1000, 1),
        "audioSeconds": round(audio_seconds, 3),
        "rtf": round(wall_seconds / audio_seconds, 3),
        "sampleRate": sample_rate,
    }


def cmd_benchmark(args):
    record = next((record for record in voice_records()
