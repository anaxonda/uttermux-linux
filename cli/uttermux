MAGIC, VERSION = 0x58544D55, 1
APP_VERSION = "0.4.0"
HEADER = struct.Struct("<IHHQI")
HELLO, LIST_VOICES, VOICE, SPEAK, AUDIO_START, AUDIO, DONE, STOP, ERROR, HEALTH, STATUS, STATE = range(1, 13)


def config_dir() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "uttermux"


def data_root() -> Path:
    return Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "uttermux"


def config_path() -> Path:
    return config_dir() / "config.toml"


def install_prefix() -> Path:
    return Path(__file__).resolve().parent.parent


def installed_data_file(relative: str) -> Path:
    candidates = (install_prefix() / "share/uttermux" / relative,
                  Path("/usr/share/uttermux") / relative,
                  Path("/usr/local/share/uttermux") / relative)
    return next((path for path in candidates if path.is_file()), candidates[0])


def installed_helper(name: str) -> Path:
    candidates = (install_prefix() / "lib/uttermux" / name,
                  install_prefix() / "lib64/uttermux" / name,
                  install_prefix() / "libexec/uttermux" / name,
                  Path("/usr/lib/uttermux") / name, Path("/usr/lib64/uttermux") / name,
                  Path("/usr/libexec/uttermux") / name)
    return next((path for path in candidates if path.exists()), candidates[0])


def socket_path() -> Path:
    return Path(os.environ.get("UTTERMUX_SOCKET", Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "uttermux.sock"))


def atomic_write(path: Path, data: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(data); stream.flush(); os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        try: os.unlink(temporary)
        except FileNotFoundError: pass


def connect() -> socket.socket:
    client = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    client.connect(str(socket_path()))
    return client


def transact(kind: int, payload: bytes = b""):
    client = connect(); request = 1
    client.sendall(HEADER.pack(MAGIC, VERSION, kind, request, len(payload)) + payload)
    try:
        while True:
            raw = client.recv(65536)
            magic, version, response_kind, rid, size = HEADER.unpack_from(raw)
            if magic != MAGIC or version != VERSION or rid != request or size != len(raw) - HEADER.size:
                raise RuntimeError("invalid response from uttermuxd")
            payload = raw[HEADER.size:]
            if response_kind == ERROR: raise RuntimeError(payload.decode(errors="replace"))
            if response_kind == DONE: return
            yield response_kind, payload
    finally: client.close()


def voices():
    for kind, payload in transact(LIST_VOICES, b"management\0"):
        if kind == VOICE:
            values = [part.decode() for part in payload.rstrip(b"\0").split(b"\0")]
            while len(values) < 6: values.append("")
            yield values[:6]


def read_config() -> dict:
    if not config_path().exists(): return {}
    with config_path().open("rb") as stream: return tomllib.load(stream)


def quote(value) -> str:
    return json.dumps(str(value), ensure_ascii=False)


def render_config(doc: dict) -> str:
    lines = ["schema_version = 2", f'max_loaded_models = {int(doc.get("max_loaded_models", 0))}',
             f'audio_cache_mb = {int(doc.get("audio_cache_mb", 64))}',
             f'local_threads = {int(doc.get("local_threads", 0))}',
             f'pocket_threads = {int(doc.get("pocket_threads", 0))}',
             f'local_silence_scale = {float(doc.get("local_silence_scale", .2))}',
             f'pocket_num_steps = {int(doc.get("pocket_num_steps", 3))}',
             f'pocket_chunk_size = {int(doc.get("pocket_chunk_size", 4))}',
             f'zipvoice_num_steps = {int(doc.get("zipvoice_num_steps", 4))}',
             f'moss_threads = {int(doc.get("moss_threads", 0))}',
             f'moss_batch_frames = {int(doc.get("moss_batch_frames", 4))}',
             f'external_idle_seconds = {int(doc.get("external_idle_seconds", 120))}',
             f'preload_default_voice = {str(bool(doc.get("preload_default_voice", False))).lower()}']
    for key in ("default_voice", "fallback_voice"):
        if doc.get(key): lines.append(f'{key} = {quote(doc[key])}')
    providers = doc.get("providers", {})
    edge = providers.get("edge", {})
    lines += ["", "[providers.edge]", f'enabled = {str(bool(edge.get("enabled", False))).lower()}',
              "locales = [" + ", ".join(quote(x) for x in edge.get("locales", ["en-US", "en-GB"])) + "]"]
    if edge.get("default_voice"):
        lines.append(f'default_voice = {quote(edge["default_voice"])}')
    eleven = providers.get("elevenlabs", {})
    lines += ["", "[providers.elevenlabs]", f'enabled = {str(bool(eleven.get("enabled", False))).lower()}',
              f'model = {quote(eleven.get("model", "eleven_flash_v2_5"))}',
              f'credential_file = {quote(eleven.get("credential_file", config_dir() / "credentials/elevenlabs-api-key"))}']
    if eleven.get("default_voice"):
        lines.append(f'default_voice = {quote(eleven["default_voice"])}')
    if eleven.get("languages"):
        lines.append("languages = [" + ", ".join(quote(x) for x in eleven["languages"]) + "]")
    for voice in eleven.get("voices", []):
        lines += ["", "[[providers.elevenlabs.voices]]", f'id = {quote(voice["id"])}',
                  f'name = {quote(voice["name"])}', f'language = {quote(voice.get("language", "en-US"))}']
    grok = providers.get("grok", {})
    lines += ["", "[providers.grok]", f'enabled = {str(bool(grok.get("enabled", False))).lower()}',
              f'credential_file = {quote(grok.get("credential_file", config_dir() / "credentials/grok-key"))}',
              f'automatic_language = {str(bool(grok.get("automatic_language", True))).lower()}']
    if grok.get("default_voice"):
        lines.append(f'default_voice = {quote(grok["default_voice"])}')
    routing = doc.get("routing", {})
    lines += ["", "[routing]",
              f'auto_detect = {str(bool(routing.get("auto_detect", True))).lower()}',
              f'minimum_characters = {int(routing.get("minimum_characters", 40))}',
              f'minimum_confidence = {float(routing.get("minimum_confidence", .8))}',
              f'default_language = {quote(routing.get("default_language", "en-US"))}',
              "provider_order = [" + ", ".join(quote(x) for x in routing.get("provider_order", ["elevenlabs", "grok", "edge", "local"])) + "]",
              f'cross_language_fallback = {str(bool(routing.get("cross_language_fallback", True))).lower()}',
              "", "[routing.voices]"]
    for language, route in sorted(routing.get("voices", {}).items()):
        if isinstance(route, str): route = [route]
        lines.append(f'{quote(language)} = [' + ", ".join(quote(x) for x in route) + "]")
    return "\n".join(lines) + "\n"


def restart() -> None:
    subprocess.run(["systemctl", "--user", "try-restart", "uttermux.service"], check=False)
    subprocess.run(["systemctl", "--user", "try-restart", "speech-dispatcher.service"], check=False)


def setup(_args):
    doc = read_config()
    doc.setdefault("max_loaded_models", 0)
    doc.setdefault("local_threads", 0)
    doc.setdefault("pocket_threads", 0)
    doc.setdefault("local_silence_scale", .2)
    doc.setdefault("pocket_num_steps", 3)
    doc.setdefault("pocket_chunk_size", 4)
    doc.setdefault("zipvoice_num_steps", 4)
    doc.setdefault("moss_threads", 0); doc.setdefault("moss_batch_frames", 4)
    doc.setdefault("external_idle_seconds", 120)
    doc.setdefault("preload_default_voice", False)
    doc.setdefault("fallback_voice", "sherpa/vits-piper-en_US-lessac-medium/lessac")
    doc.setdefault("default_voice", doc["fallback_voice"])
    doc.setdefault("providers", {})
    routing = doc.setdefault("routing", {})
    routing.setdefault("auto_detect", True); routing.setdefault("minimum_characters", 40)
    routing.setdefault("minimum_confidence", .8); routing.setdefault("default_language", "en-US")
    routing.setdefault("provider_order", ["elevenlabs", "grok", "edge", "local"])
    routing.setdefault("cross_language_fallback", True); routing.setdefault("voices", {})
    atomic_write(config_path(), render_config(doc))
    old_models = config_dir().parent / "speech-dispatcher-sherpa/models.d"
    new_models = config_dir() / "models.d"
    new_models.mkdir(parents=True, exist_ok=True)
    if old_models.is_dir():
        for source in old_models.glob("*.toml"):
            target = new_models / source.name
            if not target.exists(): shutil.copy2(source, target)
    speechd = config_dir().parent / "speech-dispatcher/speechd.conf"
    speechd.parent.mkdir(parents=True, exist_ok=True)
    current = speechd.read_text(encoding="utf-8") if speechd.exists() else ""
    begin, end = "# BEGIN uttermux", "# END uttermux"
    block = f'{begin}\nAddModule "uttermux" "sd_uttermux" "uttermux.conf"\nDefaultModule "uttermux"\n{end}'
    if begin not in current: atomic_write(speechd, current.rstrip() + "\n\n" + block + "\n")
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    subprocess.run(["systemctl", "--user", "enable", "--now", "uttermux.socket"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "--now", "uttermux-tray.service"], check=False)
    restart()
    print("UtterMux configured as the default Speech Dispatcher module.")


def language_matches(capability: str | None, requested: str | None) -> bool:
    capability = str(capability or "").replace("_", "-").casefold()
    requested = str(requested or "").replace("_", "-").casefold()
    if not capability or not requested: return False
    return capability == requested or capability.split("-", 1)[0] == requested.split("-", 1)[0]


def voice_records():
    for voice_id, name, native, provider, model, capabilities in voices():
        yield {"id": voice_id, "name": name, "native_language": native, "provider": provider,
               "model": model, "languages": [x for x in capabilities.split(",") if x] or [native]}


def catalog_path() -> Path:
    override = os.environ.get("UTTERMUX_CATALOG")
    if override: return Path(override)
    source = Path(__file__).resolve().parents[1] / "catalog/catalog.toml"
    if source.is_file(): return source
    installed = installed_data_file("catalog.toml")
    return installed


def local_catalog() -> list[dict]:
    path = catalog_path()
    if not path.is_file(): return []
    with path.open("rb") as stream: return tomllib.load(stream).get("model", [])


def hardware_profile() -> dict:
    """Report only capabilities used by the current CPU inference stack."""
    memory = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, value = line.split(":", 1)
            if key in {"MemTotal", "MemAvailable"}:
                memory[key] = int(value.strip().split()[0]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    flags = set()
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.casefold().startswith(("flags", "features")):
                flags.update(line.split(":", 1)[1].split())
    except (OSError, IndexError):
        pass
    relevant = sorted(flags.intersection(
        {"avx", "avx2", "avx512f", "fma", "sse4_2", "neon", "asimd"}))
    return {"architecture": platform.machine(), "logicalCores": os.cpu_count() or 1,
            "totalRamMb": memory.get("MemTotal", 0),
            "availableRamMb": memory.get("MemAvailable", 0),
            "cpuFeatures": relevant, "inferenceProviders": ["CPU"]}


def recommend_model(model: dict, hardware: dict) -> tuple[str, str]:
    if model.get("location") == "cloud":
        return "available", "Runs online; local CPU and memory do not determine synthesis speed."
    required = int(model.get("estimatedRamMb", 0))
    total = int(hardware.get("totalRamMb", 0))
    available = int(hardware.get("availableRamMb", 0))
    cores = int(hardware.get("logicalCores", 1))
    if required and total and required > total * .7:
        return "insufficient-memory", f"Needs about {required} MB RAM; this system has {total} MB total."
    if required and available and required > available * .75:
        return "memory-pressure", f"Needs about {required} MB RAM; only {available} MB is currently available."
    performance = model.get("performanceClass", "unknown")
    if performance == "heavy":
        if cores < 4:
            return "may-be-slow", "Heavy CPU model on a system with fewer than four logical cores."
        return "may-be-slow", "Memory should fit, but continuous reading requires a local speed benchmark."
    if performance == "balanced":
        return "likely-usable", "Expected to fit; benchmark after download for a machine-specific result."
    if performance == "fast":
        return "recommended", "Small CPU model expected to remain ahead of playback."
    return "unknown", "No machine-specific synthesis benchmark is available yet."


