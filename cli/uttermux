def cmd_eleven_clone(args):
    if not args.confirm_rights:
        raise RuntimeError("voice cloning requires --confirm-rights")
    samples = [Path(value) for value in args.audio]
    if not samples or any(not path.is_file() for path in samples):
        raise RuntimeError("all ElevenLabs reference recordings must be readable files")
    boundary = f"----UtterMux{int(time.time() * 1000)}"
    body = bytearray()

    def field(name: str, value: bytes, filename: str = "", content_type: str = "text/plain"):
        body.extend(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"".encode())
        if filename:
            filename = "".join(character for character in filename if character not in {'"', '\r', '\n'})
            body.extend(f"; filename=\"{filename}\"".encode())
        body.extend(f"\r\nContent-Type: {content_type}\r\n\r\n".encode()); body.extend(value); body.extend(b"\r\n")

    field("name", args.name.encode("utf-8"))
    field("description", (args.description or "Created by UtterMux").encode("utf-8"))
    labels = json.dumps({"language": args.language})
    field("labels", labels.encode("utf-8"), content_type="application/json")
    for sample in samples:
        field("files", sample.read_bytes(), sample.name, "application/octet-stream")
    body.extend(f"--{boundary}--\r\n".encode())
    document = read_config()
    request = urllib.request.Request("https://api.elevenlabs.io/v1/voices/add", data=bytes(body), method="POST",
        headers={"xi-api-key": elevenlabs_key(document), "Content-Type": f"multipart/form-data; boundary={boundary}",
                 "Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=120) as response: result = json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read(2048).decode(errors="replace")
        if error.code in (401, 403): detail += " (the API key needs Voices write permission)"
        raise RuntimeError(f"ElevenLabs clone HTTP {error.code}: {detail}") from None
    external_id = result["voice_id"]
    cfg = document.setdefault("providers", {}).setdefault("elevenlabs", {})
    entries = cfg.setdefault("voices", [])
    entries.append({"id": external_id, "name": args.name, "language": args.language})
    atomic_write(config_path(), render_config(document)); restart()
    print(json.dumps({"id": f"elevenlabs/{external_id}", "name": args.name,
                      "language": args.language, "remote": True,
                      "requiresVerification": bool(result.get("requires_verification"))}, indent=2))


