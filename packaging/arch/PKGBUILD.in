# Maintainer: UtterMux contributors
pkgname=uttermux
pkgver=PACKAGE_VERSION
pkgrel=1
pkgdesc='Universal local and online TTS broker for Speech Dispatcher'
arch=(x86_64 aarch64)
url='https://github.com/anaxonda/uttermux-linux'
license=(GPL-3.0-or-later)
depends=('speech-dispatcher>=0.12' libspeechd rubberband python python-gobject gtk4 python-numpy python-aiohttp python-certifi python-tabulate python-typing_extensions curl ffmpeg libpulse onnxruntime-cpu espeak-ng)
optdepends=('wl-clipboard: read Wayland selections' 'xclip: read X11 selections' 'xsel: alternate X11 selection reader')
makedepends=(cmake ninja gcc git)
_release_version=RELEASE_VERSION
_release_tag=RELEASE_TAG
source=("uttermux-linux-$_release_version.tar.gz::$url/releases/download/$_release_tag/uttermux-linux-$_release_version.tar.gz"
        "sherpa-onnx-1.13.6.tar.gz::https://github.com/k2-fsa/sherpa-onnx/archive/refs/tags/v1.13.6.tar.gz"
        "edge_tts-7.2.8-py3-none-any.whl::https://files.pythonhosted.org/packages/8c/2b/a8cb687b92a2690d2ad171f0c2fd1c8f18690363cca7618bab2bbe4cdf2b/edge_tts-7.2.8-py3-none-any.whl"
        "py3langid-0.3.0-py3-none-any.whl::https://files.pythonhosted.org/packages/9d/1c/8212ea872d236af0aea37043fb6feeaa9a43449183782b19d342f8ddd343/py3langid-0.3.0-py3-none-any.whl")
sha256sums=('PROJECT_SHA256' 'SHERPA_SHA256' '361fe48ce7ef613adbe30f664e3765dd71029c6cb57427279eff8ad6df2eb211'
            '38f022eec31cf9a2bf6f142acb2a9b350fd7d0d5ae7762b1392c6d3567401fd3')

prepare() {
  # sherpa-onnx 1.13.6 appends -Wno-format to bundled eSpeak. Arch appends
  # -Werror=format-security, which GCC 16 rejects after format checking is
  # disabled. Keep Arch's hardening and remove only the conflicting override.
  sed -i '/^[[:space:]]*-Wno-format$/d' \
    sherpa-onnx-1.13.6/cmake/espeak-ng-for-piper.cmake
  ! grep -Eq '^[[:space:]]*-Wno-format$' \
    sherpa-onnx-1.13.6/cmake/espeak-ng-for-piper.cmake
}

build() {
  local build_jobs=${UTTERMUX_BUILD_JOBS:-2}
  [[ $build_jobs =~ ^[1-9][0-9]*$ ]] || { error 'UTTERMUX_BUILD_JOBS must be a positive integer'; return 1; }
  cmake -S "sherpa-onnx-1.13.6" -B sherpa-build -G Ninja \
    -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_SHARED_LIBS=ON \
    -DSHERPA_ONNX_ENABLE_TTS=ON -DSHERPA_ONNX_ENABLE_C_API=ON \
    -DSHERPA_ONNX_ENABLE_BINARY=OFF -DSHERPA_ONNX_ENABLE_PYTHON=OFF \
    -DSHERPA_ONNX_ENABLE_TESTS=OFF -DSHERPA_ONNX_ENABLE_CHECK=OFF \
    -DSHERPA_ONNX_ENABLE_PORTAUDIO=OFF -DSHERPA_ONNX_ENABLE_WEBSOCKET=OFF \
    -DSHERPA_ONNX_ENABLE_SPEAKER_DIARIZATION=OFF \
    -DSHERPA_ONNX_USE_PRE_INSTALLED_ONNXRUNTIME_IF_AVAILABLE=ON
  ninja -C sherpa-build -j "$build_jobs"

  cmake -S "uttermux-linux-$_release_version" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF
  ninja -C build -j "$build_jobs"
}

package() {
  DESTDIR="$pkgdir" ninja -C sherpa-build install
  DESTDIR="$pkgdir" ninja -C build install
  install -d "$pkgdir/usr/lib/uttermux/vendor"
  bsdtar -xf edge_tts-7.2.8-py3-none-any.whl -C "$pkgdir/usr/lib/uttermux/vendor"
  bsdtar -xf py3langid-0.3.0-py3-none-any.whl -C "$pkgdir/usr/lib/uttermux/vendor"
}
